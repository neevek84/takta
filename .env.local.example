# takta — poste local, base SQLite dans un fichier.
#
# Copier en `.env`, renseigner les deux valeurs, puis :
#   npm run setup:local && npm run dev
#
# POSTGRES_PASSWORD n'est PAS ici : il n'y a pas de serveur Postgres.

DATABASE_URL="file:./cra.db"

# openssl rand -base64 32
AUTH_SECRET=""

# openssl rand -base64 32
# À CONSERVER. La perdre rend définitivement illisibles les jetons Google et la
# clé Dolibarr. Aucune rotation n'existe.
CREDENTIALS_KEY=""

# ── Facultatif : laisser vide tant que la fonction n'est pas voulue ──────────
SYNC_FLUSH_TOKEN=""
CRA_API_TOKEN=""
SMTP_PASSWORD=""
DOCUMENSO_URL=""
DOCUMENSO_API_KEY=""
SIGNATURE_WEBHOOK_SECRET=""
