# Postgres (serveur)
DATABASE_URL="postgresql://cra:cra@localhost:5432/cra"

# SQLite (poste local) — utiliser npm run db:sqlite
# DATABASE_URL="file:./cra.db"

AUTH_SECRET="a-remplacer-par-une-valeur-aleatoire"

# Clé de chiffrement des secrets de fournisseurs (32 octets en base64) :
#   openssl rand -base64 32
# Couvre les jetons Google Calendar (personnels) ET la clé d'API Dolibarr
# (d'instance). La perdre impose de reconnecter Google et de ressaisir la clé
# d'API Dolibarr — aucun secret n'est récupérable sans elle. Aucune donnée de
# CRA n'est perdue pour autant.
CREDENTIALS_KEY="a-remplacer-par-32-octets-en-base64"

# OAuth Google — réutilise le client existant du projet Google Cloud, en lui
# ajoutant le scope https://www.googleapis.com/auth/calendar
# Laisser vide désactive simplement la connexion : l'application fonctionne
# intégralement sans Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Fuseau des blocs poussés dans l'agenda
CRA_TIMEZONE="Europe/Paris"

# Jeton du déclenchement externe (cron, n8n) de POST /api/sync/flush.
# Vide = endpoint fermé. Le bouton « Synchroniser maintenant » suffit sans lui.
SYNC_FLUSH_TOKEN=""

# Jeton d'instance pour l'API d'événements et le réveil de l'ordonnanceur.
# Distinct de la session utilisateur : il authentifie un intégrateur, pas une
# personne. Vide = ces endpoints restent fermés, comme SYNC_FLUSH_TOKEN — une
# installation qui n'expose rien à l'extérieur est un état légitime, pas une
# panne. Générer avec : openssl rand -hex 32
CRA_API_TOKEN=""

# Mot de passe SMTP. Le reste de la configuration SMTP se saisit dans l'écran
# de supervision ; seul le secret vit dans l'environnement, comme AUTH_SECRET —
# un secret en base ressortirait dans chaque sauvegarde.
SMTP_PASSWORD=""

# Signature électronique (lot 3) — optionnelle.
# Sans ces deux valeurs, le PDF se génère et se télécharge, et les transitions
# du CRA restent manuelles.
DOCUMENSO_URL=""
DOCUMENSO_API_KEY=""

# Secret partagé avec le prestataire de signature. Sans lui, aucun webhook
# n'est accepté — l'endpoint ne s'ouvre jamais « par défaut ».
SIGNATURE_WEBHOOK_SECRET=""
