# Référence complète des variables d'environnement de takta.
#
# Ce fichier LISTE tout. Il ne se copie pas tel quel : selon l'installation,
# certaines variables n'ont aucun sens. Deux fichiers prêts à l'emploi existent
# pour ça, et c'est l'un d'eux qu'il faut copier :
#
#   .env.docker.example   conteneur, base Postgres  (NAS, VPS)
#   .env.local.example    poste local, base SQLite
#
# ─────────────────────────────────────────────────────────────────────────────
# EXIGÉ — l'installation refuse de démarrer sans
# ─────────────────────────────────────────────────────────────────────────────

# Signe les sessions. La changer déconnecte tout le monde immédiatement.
#   openssl rand -base64 32
AUTH_SECRET=""

# Scelle les secrets des connecteurs : jetons Google, clé d'API Dolibarr.
# LA PERDRE EST DÉFINITIF — aucun jeton n'est récupérable sans elle, et il
# n'existe aucune rotation. Aucune donnée de CRA n'est perdue pour autant.
#   openssl rand -base64 32
CREDENTIALS_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# LA BASE — l'une OU l'autre, jamais les deux
# ─────────────────────────────────────────────────────────────────────────────

# En conteneur : renseigner CECI, et rien d'autre pour la base.
# La composition fabrique DATABASE_URL à partir de ce mot de passe.
#   openssl rand -base64 24
POSTGRES_PASSWORD=""

# Hors conteneur : renseigner CECI, et laisser POSTGRES_PASSWORD vide.
#   Postgres : postgresql://takta:mot-de-passe@localhost:5432/takta
#   SQLite   : file:./cra.db   (avec npm run db:sqlite)
DATABASE_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# FACULTATIF — vide est un état légitime, pas une panne
# ─────────────────────────────────────────────────────────────────────────────
# Le client OAuth Google, l'URL et la clé Dolibarr, le fuseau horaire et la
# configuration SMTP NE VIVENT PAS ICI : ils se saisissent dans l'application et
# vivent chiffrés en base. Un secret dans un fichier se lit en clair.

# Ouvre POST /api/sync/flush à un déclencheur externe (cron, n8n).
# Vide = fermé. Le bouton « Synchroniser maintenant » suffit sans lui.
SYNC_FLUSH_TOKEN=""

# Ouvre l'API d'événements et le réveil de l'ordonnanceur à un intégrateur.
# Vide = fermés.
#   openssl rand -hex 32
CRA_API_TOKEN=""

# Mot de passe SMTP. Le reste de la configuration se saisit dans l'application.
SMTP_PASSWORD=""

# Signature électronique. Vides, le PDF se génère et se télécharge, et les
# transitions du CRA restent manuelles.
DOCUMENSO_URL=""
DOCUMENSO_API_KEY=""

# Secret partagé avec le prestataire de signature. Vide, aucun webhook n'est
# accepté : un point d'entrée qui verrouille un mois ne s'ouvre pas par défaut.
SIGNATURE_WEBHOOK_SECRET=""
