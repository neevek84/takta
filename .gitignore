node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

.env
.env.*
!.env.example
# Les deux fichiers prets a l'emploi, un par cible d'installation. Sans ces
# exceptions, `.env.*` les avalerait et personne ne les recevrait.
!.env.docker.example
!.env.local.example

*.db
# Les fichiers d'accompagnement de SQLite. `*.db-journal` seul ne suffisait
# pas : l'application tourne en **WAL**, et ce sont `-wal` et `-shm` qui
# portent alors les écritures pas encore repliées dans le fichier principal.
# Non ignorés, ils apparaissaient en « non suivis » — et un simple
# `git clean -fd`, qui épargne pourtant les fichiers ignorés, les emportait :
# la base restait, les dernières heures de saisie disparaissaient sans un mot.
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

coverage/
.DS_Store
*.log

# Bases jetables des executions de tests (vitest.globalSetup.ts)
prisma/test-*.db*

# Artefacts de l'empaquetage portable (scripts/empaqueter.mjs).
# Les scripts d'entree distribution/*.sh et *.cmd, eux, sont bien versionnes.
.next-dist/
distribution/build/
distribution/*.zip
prisma/.schema-portable.prisma

# Propositions de logo : fichiers de travail, pas des sources.
# La version retenue vivra dans public/ quand elle sera vectorisée.
/logo/

# Donnees d'une installation en conteneur : la base Postgres et ses
# sauvegardes vivent a cote de la composition, jamais dans le depot.
/donnees/
/sauvegardes/
